# Database URL (PostgreSQL)
# For local Docker: postgresql://toeic_user:toeic_password@localhost:5432/toeic_vocab_db?schema=public
# For Supabase / Neon / Cloud: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://toeic_user:toeic_password@localhost:5432/toeic_vocab_db?schema=public"

# Auth secret for JWT signing
AUTH_SECRET="toeic-secret-key-production-ready-2026-secure-random"

# AI Tutor API Key (Optional: Google Gemini, OpenAI, or compatible endpoint)
# Leave blank or unconfigured to use the built-in smart pedagogical TOEIC Tutor engine
AI_API_KEY=""
AI_API_URL="https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent"
